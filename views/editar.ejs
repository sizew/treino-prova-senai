<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Editar Produto</title>
</head>
<body>
    <div style="padding: 20px;">

        <a href="/produtos">⬅ Voltar para a Lista</a>
        <h2>Editar Produto</h2>

        <form action="/produtos/atualizar" method="POST">

            <!-- 1. Campo invisível para mandar o ID -->
            <input type="hidden" name="id" value="<%= produto.id %>">

            <!-- 2. Campos visíveis já preenchidos com os dados do banco -->
            <input type="text" name="nome" value="<%= produto.nome %>" required>
            <input type="text" name="descricao" value="<%= produto.descricao %>" required>
            <input type="number" name="quantidade_atual" value="<%= produto.quantidade_atual %>" required>
            <input type="number" name="estoque_minimo" value="<%= produto.estoque_minimo %>" required>

            <button type="submit">Salvar Alterações</button>
        </form>

    </div>
</body>
</html> 